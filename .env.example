# Copy to .env.local (local) and set the same values in Vercel â†’ Settings â†’ Environment Variables.

# --- Database (Neon) -------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# Direct connection string, used only for migrations (npm run db:migrate).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# --- App ---------------------------------------------------------------------
# Public URL of the deployment (used to chain job ticks and in emails).
# Local dev: http://localhost:3000. On Vercel set it to the production URL (https://hfr-pipeline.vercel.app);
# a localhost value is ignored there, and an empty one falls back to the production domain.
APP_URL=http://localhost:3000
# Links inside emails to other people always use the live address, never localhost: PUBLIC_APP_URL if set, else APP_URL when it is
# not localhost, else the Vercel production domain, else https://hfr-pipeline.vercel.app. Leave this empty unless the domain changes.
PUBLIC_APP_URL=
# Random 32+ characters. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Milliseconds of work per tick. 180000 leaves room for the slowest task inside the 300 s Hobby limit.
TICK_BUDGET_MS=180000

# --- Parallelism (optional) --------------------------------------------------
# Defaults follow this machine's CPU count. The HFR portal is still limited to one request per HFR_RATE_MS in total,
# no matter how many scrape lanes there are; validation is what scales with these.
# Lanes that fetch from the HFR portal (more lanes only overlap database work with the request wait).
# SCRAPE_LANES=2
# Lanes that validate facilities while scraping continues (default: CPU count - 1, between 2 and 6).
# COMPUTE_LANES=4
# Facilities validated at the same time inside one validation batch.
# GEO_CONCURRENCY=4
# Google / ArcGIS / MapTiler calls in flight at once across all lanes. Lower it if a provider returns 429.
# GEO_API_CONCURRENCY=8
# Database connections (default: twice the CPU count, between 6 and 16). Keep it within your database plan's limit.
# DB_POOL_MAX=8

# --- HFR portal --------------------------------------------------------------
HFR_BASE_URL=https://hfrportal.moh.go.tz/web/index.php
# Put in the scraper's User-Agent so the portal can contact you.
HFR_CONTACT_EMAIL=you@kunonu.org
# Gap between requests to the portal in milliseconds (be polite: 1000 or more).
HFR_RATE_MS=1000
# Set to false to skip the services table (saves one request per facility).
HFR_FETCH_SERVICES=true
# Share of facilities whose detail page is re-fetched each week (0.25 = all of them every ~4 weeks).
DETAIL_REFRESH_FRACTION=0.25

# --- Location checks ---------------------------------------------------------
# Server key restricted to Places API (New) + Geocoding API. Leave empty to use OpenStreetMap only.
GOOGLE_MAPS_API_KEY=
# Monthly caps that keep Google inside its free tier (Places Pro: 5,000 free; Geocoding: 10,000 free).
GOOGLE_MONTHLY_CAP=4500
GOOGLE_GEOCODE_MONTHLY_CAP=9000
# Contact address required by the Nominatim usage policy.
NOMINATIM_EMAIL=you@kunonu.org
# Optional overrides
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Comma-separated list, tried in order:
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# --- AI summary --------------------------------------------------------------
# Key from Google AI Studio (https://aistudio.google.com/apikey). Leave empty for a plain summary.
GEMINI_API_KEY=
# Any current model ID from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
REPORT_FROM=HFR Pipeline <reports@your-domain.org>
REPORT_RECIPIENTS=you@kunonu.org,colleague@kunonu.org

# --- Dashboard sign-in -------------------------------------------------------
# Random 32+ characters.
AUTH_SECRET=
# Who may sign in (magic link by email).
ALLOWED_EMAILS=you@kunonu.org
# true = no sign-in (local development only, never in production).
AUTH_DISABLED=false

# Per-request timeout for the HFR portal (ms). The portal can be slow; default 90000.
HFR_TIMEOUT_MS=90000

# --- ArcGIS (extra geocoder + basemap) --------------------------------------
# Server key from https://location.arcgis.com/ (API key with the Geocoding privilege). Used by the extra geocoder layer
# (Admin → Extra geocoder provider = ArcGIS, or Automatic when MapTiler and Google have no key).
# Forward results are stored as coordinates, so they are requested with forStorage=true and billed in credits: check your plan.
ARCGIS_API_KEY=
# Monthly cap on geocoding calls.
ARCGIS_MONTHLY_CAP=18000
# Browser key for the ArcGIS basemaps (Streets, Satellite, Topography, Light). It is public: create a separate key limited to the
# Basemaps privilege and your site's referrer. Leave empty to keep the free OpenFreeMap / Esri raster basemaps.
NEXT_PUBLIC_ARCGIS_API_KEY=

# --- MapTiler (extra geocoding layer) ---------------------------------------
# Key from https://cloud.maptiler.com/account/keys/ . Used to find missing coordinates, check each point's ward name and suggest ward links.
# Optional: with no key the layer uses GOOGLE_MAPS_API_KEY instead (Admin → Automation settings → Extra geocoder provider).
MAPTILER_API_KEY=
# Monthly cap (free tier: 100,000 requests).
MAPTILER_MONTHLY_CAP=90000
